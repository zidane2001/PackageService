{
    "databaseChangeLog": [
        {
            "changeSet": {
                "id": "001-create-package-table-v2",
                "author": "package-service",
                "changes": [
                    {
                        "createTable": {
                            "tableName": "packages",
                            "columns": [
                                {
                                    "column": {
                                        "name": "id",
                                        "type": "BIGINT",
                                        "autoIncrement": true,
                                        "constraints": {
                                            "primaryKey": true,
                                            "nullable": false
                                        }
                                    }
                                },
                                {
                                    "column": {
                                        "name": "description",
                                        "type": "VARCHAR(255)",
                                        "constraints": {
                                            "nullable": false
                                        }
                                    }
                                },
                                {
                                    "column": {
                                        "name": "weight",
                                        "type": "DOUBLE",
                                        "constraints": {
                                            "nullable": false
                                        }
                                    }
                                },
                                {
                                    "column": {
                                        "name": "fragile",
                                        "type": "BOOLEAN"
                                    }
                                },
                                {
                                    "column": {
                                        "name": "status",
                                        "type": "VARCHAR(50)",
                                        "constraints": {
                                            "nullable": false
                                        }
                                    }
                                }
                               
                            ]
                        }
                    }
                ]
            }
        }
    ]
}